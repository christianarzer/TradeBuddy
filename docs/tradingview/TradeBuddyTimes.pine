//@version=6
indicator("TradeBuddy Times + Events", overlay=true, max_lines_count=500, max_labels_count=500)

// Paste format (from TradeBuddy "TradingView Input kopieren"):
// yyyy-MM-dd HH:mm|icon|city
// Example:
// 2026-02-09 00:16|SUN_UP|Berlin
entriesInput = input.text_area(
     defval =
         "2026-02-09 00:16|SUN_UP|Berlin\n" +
         "2026-02-09 01:41|MOON_UP|Berlin\n" +
         "2026-02-09 02:04|ASTRO|Astro\n",
     title = "TradeBuddy Events (eine pro Zeile oder mit Komma getrennt)",
     group = "Source"
)

string tz = input.string("Etc/UTC", "Input timezone", group="Source")
showLines = input.bool(true, "Vertical lines", group="Display")
maxVerticalLines = input.int(400, "Max vertical lines", minval=0, maxval=500, group="Display")
showBottomMarkers = input.bool(true, "Bottom markers", group="Display")
showCityLabels = input.bool(true, "City labels", group="Display")
maxCityLabels = input.int(250, "Max city labels", minval=0, maxval=500, group="Display")
showEventTable = input.bool(true, "Bottom-right event table", group="Display")
showSun = input.bool(true, "Sun events", group="Filters")
showMoon = input.bool(true, "Moon events", group="Filters")
showAstro = input.bool(true, "Astro events", group="Filters")

// 0=SUN_UP, 1=SUN_DOWN, 2=MOON_UP, 3=MOON_DOWN, 4=ASTRO, 5=OTHER
f_icon_id(iconRaw) =>
    u = str.upper(str.trim(iconRaw))
    str.contains(u, "SUN") and str.contains(u, "UP") ? 0 :
     str.contains(u, "SUN") and str.contains(u, "DOWN") ? 1 :
     str.contains(u, "MOON") and str.contains(u, "UP") ? 2 :
     str.contains(u, "MOON") and str.contains(u, "DOWN") ? 3 :
     str.contains(u, "ASTRO") ? 4 :
     5

f_icon_enabled(iconId) =>
    iconId == 0 or iconId == 1 ? showSun :
     iconId == 2 or iconId == 3 ? showMoon :
     iconId == 4 ? showAstro :
     true

f_icon_prefix(iconId) =>
    iconId == 0 ? "SUN UP" :
     iconId == 1 ? "SUN DOWN" :
     iconId == 2 ? "MOON UP" :
     iconId == 3 ? "MOON DOWN" :
     iconId == 4 ? "ASTRO" :
     "EVENT"

f_icon_color(iconId) =>
    iconId == 0 or iconId == 1 ? color.new(#FF6D00, 0) :
     iconId == 2 or iconId == 3 ? color.new(#1565C0, 0) :
     iconId == 4 ? color.new(#6A1B9A, 0) :
     color.new(#455A64, 0)

f_icon_text_color(iconId) =>
    iconId == 0 or iconId == 1 ? #FFF3E0 :
     iconId == 2 or iconId == 3 ? #E3F2FD :
     iconId == 4 ? #F3E5F5 :
     color.white

f_city_text(cityRaw) =>
    city = str.trim(cityRaw)
    str.length(city) > 0 ? city : "City"

f_join_city(listText, cityText) =>
    str.length(listText) == 0 ? cityText : listText + ", " + cityText

f_ts(dateTimeRaw) =>
    s = str.trim(dateTimeRaw)
    parts = str.split(s, " ")
    if array.size(parts) != 2
        na
    else
        d = array.get(parts, 0)
        t = array.get(parts, 1)
        dparts = str.split(d, "-")
        tparts = str.split(t, ":")
        if array.size(dparts) != 3 or array.size(tparts) < 2
            na
        else
            y = int(str.tonumber(array.get(dparts, 0)))
            m = int(str.tonumber(array.get(dparts, 1)))
            day = int(str.tonumber(array.get(dparts, 2)))
            hh = int(str.tonumber(array.get(tparts, 0)))
            mm = int(str.tonumber(array.get(tparts, 1)))
            timestamp(tz, y, m, day, hh, mm)

var tsArr = array.new_int()
var iconIdArr = array.new_int()
var cityTextArr = array.new_string()
var shownArr = array.new_bool()
var lineRefs = array.new_line()
var cityLabelRefs = array.new_label()
var table eventTable = table.new(position.bottom_right, 1, 2, border_width=1)

if barstate.isfirst
    clean = entriesInput
    clean := str.replace_all(clean, ";", ",")
    clean := str.replace_all(clean, "\n", ",")
    clean := str.replace_all(clean, "\r", ",")

    parts = str.split(clean, ",")
    for i = 0 to array.size(parts) - 1
        raw = str.trim(array.get(parts, i))
        if str.length(raw) > 0 and not str.startswith(raw, "#")
            fields = str.split(raw, "|")
            dt = array.size(fields) >= 1 ? str.trim(array.get(fields, 0)) : ""
            iconRaw = array.size(fields) >= 2 ? str.trim(array.get(fields, 1)) : ""
            cityRaw = array.size(fields) >= 3 ? str.trim(array.get(fields, 2)) : ""

            ts = f_ts(dt)
            if not na(ts)
                array.push(tsArr, ts)
                array.push(iconIdArr, f_icon_id(iconRaw))
                array.push(cityTextArr, f_city_text(cityRaw))
                array.push(shownArr, false)

sunUpCount = 0
sunDownCount = 0
moonUpCount = 0
moonDownCount = 0
astroCount = 0
otherCount = 0

sunUpCities = ""
sunDownCities = ""
moonUpCities = ""
moonDownCities = ""
astroCities = ""
otherCities = ""

if array.size(tsArr) > 0

    for i = 0 to array.size(tsArr) - 1
        if not array.get(shownArr, i)
            ts = array.get(tsArr, i)
            inBar = time <= ts and ts < time_close
            if inBar
                iconId = array.get(iconIdArr, i)
                if f_icon_enabled(iconId)
                    if showLines and maxVerticalLines > 0
                        if array.size(lineRefs) >= maxVerticalLines
                            oldLine = array.shift(lineRefs)
                            line.delete(oldLine)

                        lineColor = color.new(f_icon_color(iconId), 35)
                        newLine = line.new(
                            x1 = ts,
                            y1 = 0,
                            x2 = ts,
                            y2 = 1,
                            xloc = xloc.bar_time,
                            extend = extend.both,
                            color = lineColor,
                            style = line.style_dotted,
                            width = 1
                        )
                        array.push(lineRefs, newLine)

                    cityText = array.get(cityTextArr, i)
                    if showCityLabels and maxCityLabels > 0
                        if array.size(cityLabelRefs) >= maxCityLabels
                            oldCityLabel = array.shift(cityLabelRefs)
                            label.delete(oldCityLabel)

                        cityLabelText = f_icon_prefix(iconId) + " | " + cityText
                        cityLabel = label.new(
                            x = ts,
                            y = low,
                            text = cityLabelText,
                            xloc = xloc.bar_time,
                            yloc = yloc.belowbar,
                            style = label.style_label_up,
                            color = f_icon_color(iconId),
                            textcolor = f_icon_text_color(iconId),
                            size = size.tiny
                        )
                        array.push(cityLabelRefs, cityLabel)

                    if iconId == 0
                        sunUpCount += 1
                        sunUpCities := f_join_city(sunUpCities, cityText)
                    else if iconId == 1
                        sunDownCount += 1
                        sunDownCities := f_join_city(sunDownCities, cityText)
                    else if iconId == 2
                        moonUpCount += 1
                        moonUpCities := f_join_city(moonUpCities, cityText)
                    else if iconId == 3
                        moonDownCount += 1
                        moonDownCities := f_join_city(moonDownCities, cityText)
                    else if iconId == 4
                        astroCount += 1
                        astroCities := f_join_city(astroCities, cityText)
                    else
                        otherCount += 1
                        otherCities := f_join_city(otherCities, cityText)

                array.set(shownArr, i, true)

plotshape(showBottomMarkers and showSun and sunUpCount > 0, title="SUN_UP_MARKER", style=shape.triangleup, location=location.bottom, color=f_icon_color(0), text="SU", textcolor=f_icon_text_color(0), size=size.tiny)
plotshape(showBottomMarkers and showSun and sunDownCount > 0, title="SUN_DOWN_MARKER", style=shape.triangledown, location=location.bottom, color=f_icon_color(1), text="SD", textcolor=f_icon_text_color(1), size=size.tiny)
plotshape(showBottomMarkers and showMoon and moonUpCount > 0, title="MOON_UP_MARKER", style=shape.triangleup, location=location.bottom, color=f_icon_color(2), text="MU", textcolor=f_icon_text_color(2), size=size.tiny)
plotshape(showBottomMarkers and showMoon and moonDownCount > 0, title="MOON_DOWN_MARKER", style=shape.triangledown, location=location.bottom, color=f_icon_color(3), text="MD", textcolor=f_icon_text_color(3), size=size.tiny)
plotshape(showBottomMarkers and showAstro and astroCount > 0, title="ASTRO_MARKER", style=shape.diamond, location=location.bottom, color=f_icon_color(4), text="AS", textcolor=f_icon_text_color(4), size=size.tiny)
plotshape(showBottomMarkers and otherCount > 0, title="OTHER_MARKER", style=shape.circle, location=location.bottom, color=f_icon_color(5), text="OT", textcolor=f_icon_text_color(5), size=size.tiny)

if showEventTable
    table.cell(
        eventTable,
        0,
        0,
        "TradeBuddy Event Details",
        text_color=color.white,
        text_size=size.small,
        bgcolor=color.new(#1B1E23, 0)
    )
    details = ""
    if showSun and sunUpCount > 0
        details += "SUN UP (" + str.tostring(sunUpCount) + "): " + sunUpCities + "\n"
    if showSun and sunDownCount > 0
        details += "SUN DOWN (" + str.tostring(sunDownCount) + "): " + sunDownCities + "\n"
    if showMoon and moonUpCount > 0
        details += "MOON UP (" + str.tostring(moonUpCount) + "): " + moonUpCities + "\n"
    if showMoon and moonDownCount > 0
        details += "MOON DOWN (" + str.tostring(moonDownCount) + "): " + moonDownCities + "\n"
    if showAstro and astroCount > 0
        details += "ASTRO (" + str.tostring(astroCount) + "): " + astroCities + "\n"
    if otherCount > 0
        details += "OTHER (" + str.tostring(otherCount) + "): " + otherCities + "\n"
    if str.length(details) == 0
        details := "No events on this bar."
    table.cell(
        eventTable,
        0,
        1,
        details,
        text_color=color.new(color.white, 0),
        text_size=size.tiny,
        bgcolor=color.new(#0F1115, 0)
    )
else
    table.cell(eventTable, 0, 0, "", bgcolor=color.new(color.black, 100))
    table.cell(eventTable, 0, 1, "", bgcolor=color.new(color.black, 100))
